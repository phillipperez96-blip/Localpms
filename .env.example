# LocalPMS configuration
# Copy this file to ".env" and fill in the services you want to turn on.
# Anything left blank stays in DEMO MODE (simulated, nothing is sent or charged).

PORT=3001

# --- Card payments (Stripe) -------------------------------------------------
# Dashboard → Developers → API keys. Use test keys (sk_test_/pk_test_) first.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Email (SendGrid) -------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=office@yourcompany.com

# --- Text messages (Twilio) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15125550100

# --- Gate access control ----------------------------------------------------
# LocalPMS POSTs JSON to this URL whenever a code is created, removed, or
# access is suspended/restored: { action, facility_id, code, allowed, units, tenant }
# Point it at your gate vendor's API or a small bridge service.
GATE_WEBHOOK_URL=
GATE_API_KEY=

# --- Security ----------------------------------------------------------------
# Set to 1 to hide the one-click demo account buttons on the login screen (do this for real use).
# HIDE_DEMO_ACCOUNTS=1

# --- Storage ----------------------------------------------------------------
# DATA_DIR=./data
